# Vite publishes VITE_* values to the browser. Use only the Supabase project URL
# and publishable key here. Never put a Supabase secret/service-role key in VITE_*.
VITE_SUPABASE_URL=https://your-pos-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Outlet edge process. Demo defaults are available only outside production.
POS_TENANT_ID=
POS_TENANT_NAME=
POS_OUTLET_ID=
POS_OUTLET_NAME=
POS_TERMINAL_ID=
POS_TERMINAL_NAME=
POS_LOCATION_LABEL=Restaurant outlet
POS_ACTOR_ID=
POS_TIMEZONE=Asia/Kolkata
POS_CURRENCY=INR
POS_TAX_RATE_BPS=500
POS_SESSION_SECRET=replace-with-a-random-32-byte-or-longer-secret
POS_COOKIE_SECURE=true
POS_DATABASE_PATH=.data/common-table.db
# Production keeps one verified SQLite backup per day for seven days by default.
POS_AUTO_BACKUP=true
POS_AUTO_BACKUP_RETENTION_DAYS=7
# Optional: point backups at a mounted encrypted drive or other durable location.
# POS_BACKUP_DIR=/path/to/private/pos-backups
# Set these after enrolling the terminal in the manager portal. The key is a
# one-time secret: keep it on the outlet edge and never add it to VITE_* vars.
POS_SYNC_URL=https://your-pos-project.supabase.co/functions/v1/pos-sync
POS_TERMINAL_KEY=

# Printers: mock is the non-production default; production defaults to disabled.
# For a compatible LAN ESC/POS printer, set POS_PRINTER_MODE=network and provide
# its static/local IP. This adapter sends raw TCP to the configured host/port.
# POS_PRINTER_MODE=network
# POS_PRINTER_HOST=192.168.1.50
# POS_PRINTER_PORT=9100
# Development mock printer only:
# POS_PRINTER_MODE=mock
MOCK_PRINTER_HOST=127.0.0.1
MOCK_PRINTER_PORT=9100
