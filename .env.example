# Vite publishes VITE_* values to the browser. Use only the Supabase project URL
# and publishable key here. Never put a Supabase secret/service-role key in VITE_*.
VITE_SUPABASE_URL=https://your-pos-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Outlet edge process. Demo defaults are available only outside production.
POS_TENANT_ID=
POS_TENANT_NAME=
POS_OUTLET_ID=
POS_OUTLET_NAME=
POS_TERMINAL_ID=
POS_TERMINAL_NAME=
POS_LOCATION_LABEL=Restaurant outlet
POS_ACTOR_ID=
POS_TIMEZONE=Asia/Kolkata
POS_CURRENCY=INR
POS_TAX_RATE_BPS=500
POS_DATABASE_PATH=.data/common-table.db

# Development printer emulator only.
MOCK_PRINTER_HOST=127.0.0.1
MOCK_PRINTER_PORT=9100
